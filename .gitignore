# macOS
.DS_Store

# Editor settings (machine-specific absolute paths)
.vscode/

# Local backup of the upstream PaddleOCR git history
/.paddleocr-upstream.git/

# Python
/.venv/
__pycache__/
*.pyc

# Real documents used as OCR input: never commit them
/experiments/vietnamese_baseline/input/*
!/experiments/vietnamese_baseline/input/.gitkeep

# Page images of those documents, copied next to the annotation candidates
/benchmarks/vietnamese/annotation_candidates/**/*.png

# Baseline OCR outputs (regenerated by run_ocr.py)
/experiments/vietnamese_baseline/output/*
!/experiments/vietnamese_baseline/output/.gitkeep

# VietOCR (PyTorch) environment, kept apart from the PaddlePaddle one
/.venv-vietocr/

# Model weights downloaded for inspection or benchmarking: never commit them
/models/

# Recognizer bake-off: line crops are pieces of the real documents
/benchmarks/vietnamese/recognizer_bakeoff/crops/*
!/benchmarks/vietnamese/recognizer_bakeoff/crops/.gitkeep
/benchmarks/vietnamese/recognizer_bakeoff/annotation/candidates/*
!/benchmarks/vietnamese/recognizer_bakeoff/annotation/candidates/.gitkeep

# Recognizer bake-off: predictions are regenerated by run_ppocr_rec.py / run_vietocr.py
/benchmarks/vietnamese/recognizer_bakeoff/predictions/*
!/benchmarks/vietnamese/recognizer_bakeoff/predictions/.gitkeep

# Recognizer bake-off: files holding text of the real documents (predictions
# inside the crop manifest, the annotation table and its ground truth, results
# quoting lines). Local only for now. The ground truth is human work that
# cannot be regenerated: back it up, or delete its lines here to version it.
/benchmarks/vietnamese/recognizer_bakeoff/manifest.jsonl
/benchmarks/vietnamese/recognizer_bakeoff/export_metadata.json
/benchmarks/vietnamese/recognizer_bakeoff/annotation/*
!/benchmarks/vietnamese/recognizer_bakeoff/annotation/candidates/
/benchmarks/vietnamese/recognizer_bakeoff/results/*
!/benchmarks/vietnamese/recognizer_bakeoff/results/ppocrv6_head_analysis.json
!/benchmarks/vietnamese/recognizer_bakeoff/results/ppocrv6_medium_rec_state_dict.csv
# Aggregate metrics of the bake-off: numbers and labels only, no line of text.
!/benchmarks/vietnamese/recognizer_bakeoff/results/summary.json
!/benchmarks/vietnamese/recognizer_bakeoff/results/recognizer_metrics.csv
!/benchmarks/vietnamese/recognizer_bakeoff/results/line_length_groups.csv
!/benchmarks/vietnamese/recognizer_bakeoff/results/ground_truth_source_groups.csv
!/benchmarks/vietnamese/recognizer_bakeoff/results/missing_characters.csv
