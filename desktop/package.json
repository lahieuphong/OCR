{
  "name": "vietdoc-ocr-desktop",
  "productName": "VietDoc OCR",
  "version": "0.1.2",
  "private": true,
  "description": "Windows desktop shell for the local VietDoc OCR app (development MVP; not a standalone build)",
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "npm --prefix ../demo/local_pdf_ocr/frontend run build",
    "start": "node scripts/launch.js",
    "dev": "npm run build:frontend && node scripts/launch.js",
    "smoke": "node scripts/launch.js --smoke-test=out/smoke",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.17.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
